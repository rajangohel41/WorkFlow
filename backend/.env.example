# WorkFlow Backend — Environment Configuration
# Copy this file to .env and supply the required values. Never commit real credentials.

# Server Configuration
PORT=5000
NODE_ENV=development

# Database URIs
# Local Development: mongodb://127.0.0.1:27017/workflow
# Automated Tests: mongodb://127.0.0.1:27017/workflow_test
# Production / Staging Atlas URI: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/workflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/workflow
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/workflow_test

# Client & CORS Allowed Origins
# Comma-separated list of allowed frontend origins (e.g. production domain, preview domain)
CLIENT_ORIGIN=http://localhost:8443
# Optional: Set to "true" to permit standard Vercel preview URLs (https://*.vercel.app)
ALLOW_VERCEL_PREVIEWS=false
# Optional: Strict regex pattern for preview domains (e.g. ^https:\/\/workflow-[a-zA-Z0-9_-]+-myteam\.vercel\.app$)
VERCEL_PREVIEW_PATTERN=

# JWT Secrets (Minimum 32 random characters required for production)
JWT_ACCESS_SECRET=d41bb970171a16c22dd726571800bb5538866e1843070e0755219d26e83ced91
JWT_REFRESH_SECRET=f13526dae70c129c615a2a2c930788af25a5686690526196d299fcc6bc980298
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Password Recovery
# Keep false unless an automated email delivery service is configured. (Self-service recovery is disabled by default)
ENABLE_PASSWORD_RECOVERY=false

# Realtime / Multi-Instance WebSocket Adapter (Optional)
# If running Socket.IO across multiple serverless/container instances, configure a Redis connection URI:
# REDIS_URL=rediss://default:<password>@<host>:<port>

# Attachment Storage (Optional)
# Directory path for local uploaded attachments. Defaults to 'uploads' in the project directory:
# UPLOADS_DIR=/var/data/uploads
# For Vercel Serverless / Cloud Object Storage, configure a Vercel Blob read-write token:
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx
