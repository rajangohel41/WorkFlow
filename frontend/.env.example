# WorkFlow Frontend — Environment Configuration
# Copy this file to .env and supply the required values. Never commit real credentials.

# API Base URL
# Development (with Vite proxy): /api/v1 or http://localhost:5000/api/v1
# Vercel Production: https://your-backend-domain.vercel.app/api/v1 (or https://api.yourdomain.com/api/v1)
VITE_API_URL=/api/v1

# Realtime WebSocket / Socket.IO Server URL
# Development: http://localhost:5000
# Production: https://api.yourdomain.com (persistent server) or https://your-backend-domain.vercel.app
VITE_SOCKET_URL=http://localhost:5000
